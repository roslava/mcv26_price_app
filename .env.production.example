# Public and admin URL prefixes (trailing slash is optional).
MCV26_PUBLIC_BASE_PATH=/new-price/
MCV26_ADMIN_BASE_PATH=/price-admin/

# MariaDB/MySQL connection. Prefer DSN in production.
MCV26_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=mcv26_price;charset=utf8mb4
MCV26_DB_USER=REPLACE_WITH_DEDICATED_DB_USER
MCV26_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Administrative login. Store only a password hash, never plaintext.
MCV26_ADMIN_LOGIN=REPLACE_WITH_ADMIN_LOGIN
MCV26_ADMIN_PASSWORD_HASH=REPLACE_WITH_PASSWORD_HASH
